
# Public URL of the frontend — used in verification email links
FRONTEND_URL=https://task-mangement-frontend-ph-2.vercel.app
# Optional: key for the short-lived encrypted password (defaults to one derived from JWT_SECRET)
# CREDENTIAL_SECRET=

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# MoM video calls (built-in WebRTC)
# Public address of the frontend — used in the meeting links emailed to attendees (use https outside localhost)
FRONTEND_URL=https://task-mangement-frontend-ph-2.vercel.app
# The link opens this many minutes before the start, and closes this many minutes after the end
MEETING_JOIN_EARLY_MINUTES=15
MEETING_JOIN_LATE_MINUTES=30
# People per call (each browser connects to every other one)
MEETING_MAX_PARTICIPANTS=8
# STUN: Google's free public servers are used when this is empty
STUN_URLS=
# TURN (relay for strict firewalls / mobile data). Google has no public TURN — run coturn
# (see deploy/turnserver.conf.example) or use a TURN provider.
TURN_URLS=
# coturn "use-auth-secret": the backend makes short-lived passwords per user (recommended)
TURN_SECRET=
TURN_TTL_SECONDS=43200
# …or one fixed login from a TURN provider
TURN_USERNAME=
TURN_CREDENTIAL=
# true = send every call through TURN
WEBRTC_FORCE_RELAY=false

# Optional: whisper.cpp server for the video-call transcript (the engine Meetily is built on).
# Build https://github.com/ggml-org/whisper.cpp, download a model, then run e.g.:
#   ./build/bin/whisper-server -m models/ggml-base.en.bin --host 127.0.0.1 --port 8178
# Empty = the built-in Whisper worker is used.
WHISPER_SERVER_URL=

# Telegram bot — create one with @BotFather in Telegram and paste its token here.
# Empty = the bot is off. Users connect it from Settings → Notifications → Telegram.
TELEGRAM_BOT_TOKEN=
# Only ONE server may poll this token. Set false on every copy except production (local dev, staging).
TELEGRAM_POLLING=true
# Optional: where the bot reaches this API (default http://127.0.0.1:<PORT>)
# TELEGRAM_INTERNAL_API_URL=

# File storage — Cloudinary (task, Task Bank, chat, MoM files and meeting recordings).
# Set CLOUDINARY_URL (Cloudinary dashboard → API Keys → "API environment variable")
# OR the three separate values. Empty = files are kept on disk in backend/uploads/ (local dev).
# Files are stored privately and only served through the app's logged-in download links.
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary media library
CLOUDINARY_FOLDER=task-management
# FILE_STORAGE=local forces disk storage even when Cloudinary keys are set
# Move files already in backend/uploads/ to Cloudinary: npm run migrate:cloudinary
